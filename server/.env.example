JWT_SECRET=길고_예측하기_어려운_문자열

# OpenAI — 학부모 AI 일일 리포트 (gpt-4o-mini)
OPENAI_API_KEY=sk-...
# 선택. 기본 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# WebClip 진입 후 리다이렉트할 웹앱 주소 (serial URL 세탁용)
WEB_APP_URL=http://localhost:5173
