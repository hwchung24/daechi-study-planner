# Supabase Postgres (Transaction pooler 권장)
DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=길고_예측하기_어려운_문자열

# production에서 학생 API·로그인·회원가입을 웹에서 막음(헤더 X-Daechi-Client: native 필요).
# 스테이징 등에서 서버만 완화하려면 true
# STUDENT_WEB_API_OK=true

# OpenAI — 학생 AI 코치 채팅 + 학부모 일일 리포트 (기본 gpt-4o-mini)
OPENAI_API_KEY=sk-...
# 선택. 기본 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# WebClip 진입 후 리다이렉트할 웹앱 주소 (serial URL 세탁용)
WEB_APP_URL=http://localhost:5173

# SimpleMDM 연동용 API 키
# 학생 앱스토어에서 앱 설치/삭제를 처리할 때 필요
SIMPLEMDM_API_KEY=smdm_...
# 허용앱 이름 기반 프로파일(Simple MDM에 동일 이름으로 생성). 기본값: default / utility / free / block
# SIMPLEMDM_APP_ALLOWANCE_BLOCK_PROFILE=block

# Solapi 카카오 알림톡
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=029302266
SOLAPI_KAKAO_PFID=
SOLAPI_KAKAO_TEMPLATE_ID=
# 학부모 인앱 알림과 동일한 내용을 카카오 알림톡으로 보냄(Solapi 카카오 설정 필요).
# 비우면 켜진 것으로 간주. 끄려면 false
# SOLAPI_ENABLE_PARENT_KAKAO_NOTIFICATIONS=false
# 운영에서는 기본적으로 테스트 엔드포인트 비활성화
# SOLAPI_TEST_ENDPOINT_ENABLED=false

# 학부모 회원가입 휴대폰 인증(SMS, Solapi API_KEY/SECRET/SENDER 필요)
# OTP 해시용 시크릿(미설정 시 JWT_SECRET 사용)
# PARENT_SIGNUP_OTP_SECRET=
# 로컬에서 SMS 없이 테스트: 문자 발송 생략(서버 로그에 OTP 출력은 아래 옵션)
# PARENT_SIGNUP_DEV_NO_SMS=true
# PARENT_SIGNUP_DEV_PRINT_OTP=true
